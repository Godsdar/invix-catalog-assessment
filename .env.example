# Local infrastructure only. Change passwords before any public deployment.
POSTGRES_PASSWORD=local-catalog-db
S3_ACCESS_KEY=local-minio-user
S3_SECRET_KEY=local-minio-password
# Fill before running --profile telegram. Never commit .env.
BOT_TOKEN=
ADMIN_IDS=
WEBHOOK_SECRET=
# Public HTTPS URL for the gateway. Never expose MinIO/Postgres directly.
MINI_APP_URL=https://example.com
HTTP_PORT=8080
